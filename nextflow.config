params {
    input = null
    outdir = "results"
}

profiles {

    local {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'standard'
        process.clusterOptions = '--account=amr_services_paid'
    }
}

process {
    cpus = 1
    memory = '4 GB'
    time = '1h'

    withName: COVERAGE {
        cpus = 4
        memory = '20 GB'
        time = '1h'
    }

    withName: ASSEMBLY {
        cpus = 16
        memory = '64 GB'
        time = '48h'
    }
}
