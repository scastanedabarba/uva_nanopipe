params {
    input = null
    outdir = "results"
}

profiles {

    local {
        process.executor = 'local'
        process.conda = true
        conda.enabled = true
    }

    conda {
        process.executor = 'local'
        process.conda = true
        conda.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        process.conda = true
        conda.enabled = true
    }

    apptainer {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}

process {
    withName: COVERAGE {
        cpus = 4
        memory = '20 GB'
        time = '8h'

        publishDir = [
            path: "${params.outdir}/coverage",
            mode: 'copy'
        ]
    }
}
