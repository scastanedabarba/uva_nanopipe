params {
    input = null
    outdir = "results"

    read_type = "ont_r10"
    autocycler_jobs = 4
    keep_subsampled_reads = false

    plassembler_db = null

    assemblers = [
        "raven",
        "miniasm",
        "flye",
        "metamdbg",
        "necat",
        "nextdenovo",
        "plassembler",
        "canu"
    ]
}

conda {
    enabled = false
}

profiles {

    local {
        process.executor = 'local'
        conda.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        conda.enabled = true
    }

    apptainer {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}

executor {
    // Rivanna/SLURM can report jobs as active while Nextflow is waiting for .exitcode.
    // Canu jobs may run for many minutes/hours before .exitcode is written.
    exitReadTimeout = '2 h'
}

process {
    withName: COVERAGE {
        cpus = 4
        memory = '20 GB'
        time = '8h'

        publishDir = [
            path: "${params.outdir}/coverage",
            mode: 'copy'
        ]
    }

    withName: SUMMARIZE_COVERAGE {
        cpus = 1
        memory = '2 GB'
        time = '30m'

        publishDir = [
            path: "${params.outdir}",
            mode: 'copy'
        ]
    }

    withName: AUTOCYCLER_SUBSAMPLE {
        cpus = 4
        memory = '20 GB'
        time = '8h'

        publishDir = [
            path: "${params.outdir}/assembly",
            mode: 'copy'
        ]
    }

    withName: AUTOCYCLER_ASSEMBLE {
        cpus = 8
        memory = '200 GB'
        time = '24h'

        publishDir = [
            path: "${params.outdir}/assembly",
            mode: 'copy'
        ]
    }

    withName: AUTOCYCLER_WEIGHT {
        cpus = 1
        memory = '4 GB'
        time = '1h'

        publishDir = [
            path: "${params.outdir}/assembly",
            mode: 'copy'
        ]
    }

    withName: AUTOCYCLER_FINISH {
        cpus = 8
        memory = '32 GB'
        time = '24h'

        publishDir = [
            path: "${params.outdir}/assembly",
            mode: 'copy'
        ]
    }
}
