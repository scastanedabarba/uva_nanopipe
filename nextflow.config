params {
    input = null
    outdir = "results"
}

conda {
    enabled = false
}

profiles {

    local {
        process.executor = 'local'
        conda.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        conda.enabled = true
    }

    apptainer {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}

process {
    withName: COVERAGE {
        cpus = 4
        memory = '20 GB'
        time = '8h'

        publishDir = [
            path: "${params.outdir}/coverage",
            mode: 'copy'
        ]
    }

    withName: SUMMARIZE_COVERAGE {
        cpus = 1
        memory = '2 GB'
        time = '30m'

        publishDir = [
            path: "${params.outdir}",
            mode: 'copy'
        ]
    }
}
