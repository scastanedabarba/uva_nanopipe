params {
    input = null
    outdir = "results"
}

profiles {

    conda {

        process.executor = 'slurm'
        process.queue = 'standard'
        process.clusterOptions = '--account=amr_services_paid'

        process.conda = true

        conda {
            enabled = true
            cacheDir = "/scratch/sgj4qr/nextflow_conda"
        }
    }

    apptainer {

        process.executor = 'slurm'
        process.queue = 'standard'
        process.clusterOptions = '--account=amr_services_paid'

        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
